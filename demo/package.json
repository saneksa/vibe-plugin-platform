{
  "name": "vibe-plugin-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "examples:pack": "for d in examples/*/; do case \"$d\" in */_template/) continue;; esac; test -f \"$d/manifest.json\" || continue; npm --prefix \"$d\" run pack || exit 1; done",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run && playwright test tests/conformance.test.ts tests/e2e.spec.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts"
  },
  "dependencies": {
    "@vibe/plugin-contracts": "file:../contracts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.1",
    "vue": "^3.5.0"
  }
}
